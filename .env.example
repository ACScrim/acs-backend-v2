# Variables d'environnement requises pour ACS Backend V2

# ===========================
# Base de données MongoDB
# ===========================
MONGODB_URI=mongodb://localhost:27017/acs-v2

# ===========================
# Secrets de sécurité
# ATTENTION: Ces valeurs doivent être changées en production!
# Utilisez des valeurs aléatoires fortes (minimum 32 caractères)
# ===========================

# Secret pour JWT (minimum 32 caractères)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# Secret pour les cookies (minimum 32 caractères)
COOKIE_SECRET=your-super-secret-cookie-key-change-this-in-production-min-32-chars

# Secret pour les sessions (minimum 32 caractères)
SESSION_SECRET=your-super-secret-session-key-change-this-in-production-min-32-chars

# ===========================
# Discord OAuth2
# ===========================
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_BOT_TOKEN=your-discord-bot-token

# Délai entre les lots lors de la mise à jour des avatars Discord (en millisecondes)
# Par défaut: 1000ms (1 seconde)
DISCORD_BATCH_DELAY_MS=1000

# ===========================
# URLs et Configuration
# ===========================
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# CORS - Liste des origines autorisées séparées par des virgules
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://v2.acscrim.fr

# ===========================
# Environnement
# ===========================
NODE_ENV=development

# ===========================
# Services externes (optionnel)
# ===========================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ===========================
# Challonge (optionnel)
# ===========================
CHALLONGE_API_KEY=
